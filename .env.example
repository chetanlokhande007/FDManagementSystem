# ═══════════════════════════════════════════════════════════════
#  FinTrust FD Manager — Environment Variables
# ═══════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in the values:
#    cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Database ──
DB_NAME=FDManagementDB
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_PORT=5432

# ── JWT Authentication ──
# Must be at least 32 characters
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ISSUER=FinTrustFDManager
JWT_AUDIENCE=FinTrustFDManagerUsers

# ── Ports ──
API_PORT=8080
FRONTEND_PORT=80

# ── ASP.NET Core ──
ASPNETCORE_ENVIRONMENT=Production
